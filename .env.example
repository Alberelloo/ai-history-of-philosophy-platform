# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
POSTGRES_PASSWORD=
DEEPSEEK_API_KEY=
# Хеш пароля оператора: python -c "from philograph.operator.access import hash_password; print(hash_password('...'))"
PHILOGRAPH_OPERATOR_PASSWORD_HASH=
# Соль для обезличивания посетителей (любая длинная случайная строка).
PHILOGRAPH_VISITOR_SECRET=
# Служебный токен для внутренних метрик (оповещения); любая длинная случайная строка.
PHILOGRAPH_INTERNAL_TOKEN=

# --- публичный сервер (compose.prod.yaml) ---
# Домен, для которого Caddy выпустит сертификат.
PHILOGRAPH_DOMAIN=
# Ключ шифрования копий: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Храните его отдельно от копий (менеджер паролей): без него копию не прочитать.
PHILOGRAPH_BACKUP_KEY=
# Куда класть копии: каталог смонтированного внешнего хранилища или s3://bucket/prefix.
PHILOGRAPH_BACKUP_DIR=./backups
# Канал оповещений: Telegram или произвольный вебхук (POST {"text": ...}).
PHILOGRAPH_ALERT_TELEGRAM_TOKEN=
PHILOGRAPH_ALERT_TELEGRAM_CHAT=
PHILOGRAPH_ALERT_WEBHOOK=

# --- регион читателя (ограничение источников по странам, compose.prod.yaml) ---
# Имя заголовка, которым CDN передаёт страну читателя (у Cloudflare — CF-IPCountry).
# Обязателен в продакшене: без него шлюз не узнает страну и закроет ограниченные источники.
PHILOGRAPH_REGION_HEADER=
# Диапазоны IP/CIDR, с которых CDN обращается к серверу. По ним Caddy отличает запрос от CDN
# от прямого обращения и верит заголовку страны только от CDN. Несколько диапазонов —
# через пробел в кавычках, например: PHILOGRAPH_CDN_IPS="1.2.3.0/24 5.6.7.0/24".
PHILOGRAPH_CDN_IPS=
# Запасной регион вместо неизвестного. Только для стенда разработки и сквозных тестов (RU);
# в продакшене оставьте пустым, иначе ограничение регионов обходится.
PHILOGRAPH_REGION_FALLBACK=
